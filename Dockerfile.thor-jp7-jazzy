# syntax=docker/dockerfile:1
# Experimental Thor JetPack 7 / Ubuntu 24.04 variant.
# IMPORTANT: ROS Humble official binaries target Ubuntu 22.04; for Ubuntu 24.04 use ROS Jazzy.
# Use this only when your Thor is JetPack 7 / L4T r38 / Ubuntu 24.04.

ARG BASE_IMAGE=nvcr.io/nvidia/cuda:13.0.2-devel-ubuntu24.04
FROM ${BASE_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG USERNAME=work
ARG UID=1000
ARG GID=1000
ARG ROS_DISTRO=jazzy
ARG ROS_INSTALL=desktop
ARG INSTALL_OLLAMA_SERVER=1

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Asia/Taipei \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    USERNAME=${USERNAME} \
    ROS_DISTRO=${ROS_DISTRO} \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    QT_X11_NO_MITSHM=1 \
    XDG_RUNTIME_DIR=/tmp/runtime-${USERNAME} \
    HF_HOME=/workspace/.cache/huggingface \
    HUGGINGFACE_HUB_CACHE=/workspace/.cache/huggingface \
    TRANSFORMERS_CACHE=/workspace/.cache/huggingface \
    OLLAMA_HOST=0.0.0.0:11434 \
    OLLAMA_MODELS=/workspace/.ollama/models

RUN apt-get update && apt-get install -y --no-install-recommends \
    locales tzdata sudo curl wget git vim nano gnupg lsb-release ca-certificates \
    software-properties-common build-essential pkg-config cmake ninja-build \
    ffmpeg x11-apps mesa-utils iputils-ping net-tools dnsutils \
    postgresql-client libpq-dev zstd \
    python3 python3-dev python3-pip python3-venv python-is-python3 \
    python3-opencv libopencv-dev \
    libgl1 libgl1-mesa-glx libglib2.0-0 libsm6 libxext6 libxrender1 \
    libfontconfig1 libdbus-1-3 libxkbcommon-x11-0 libx11-xcb1 \
    libgtk-3-0 qtbase5-dev \
    && locale-gen en_US en_US.UTF-8 \
    && update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 \
    && add-apt-repository universe \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && export ROS_APT_SOURCE_VERSION=$(curl -s https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest | grep -F "tag_name" | awk -F'\"' '{print $4}') \
    && curl -fsSL -o /tmp/ros2-apt-source.deb \
        "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${ROS_APT_SOURCE_VERSION}/ros2-apt-source_${ROS_APT_SOURCE_VERSION}.$(. /etc/os-release && echo ${UBUNTU_CODENAME:-${VERSION_CODENAME}})_all.deb" \
    && dpkg -i /tmp/ros2-apt-source.deb \
    && rm /tmp/ros2-apt-source.deb \
    && rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-${ROS_INSTALL} \
    ros-${ROS_DISTRO}-cv-bridge \
    ros-${ROS_DISTRO}-vision-opencv \
    ros-${ROS_DISTRO}-image-transport \
    ros-${ROS_DISTRO}-tf2-ros \
    ros-${ROS_DISTRO}-tf-transformations \
    ros-${ROS_DISTRO}-robot-state-publisher \
    ros-${ROS_DISTRO}-joint-state-publisher \
    ros-${ROS_DISTRO}-xacro \
    ros-${ROS_DISTRO}-rviz2 \
    ros-${ROS_DISTRO}-rmw-cyclonedds-cpp \
    ros-${ROS_DISTRO}-navigation2 \
    ros-${ROS_DISTRO}-nav2-bringup \
    ros-${ROS_DISTRO}-nav2-msgs \
    ros-${ROS_DISTRO}-slam-toolbox \
    python3-colcon-common-extensions python3-vcstool python3-rosdep python3-argcomplete \
    && rm -rf /var/lib/apt/lists/*

RUN rosdep init || true && rosdep update --rosdistro ${ROS_DISTRO} || true

COPY requirements.robot_object.txt /tmp/requirements.robot_object.txt
RUN python3 -m pip install --upgrade pip setuptools wheel --break-system-packages \
    && python3 -m pip install --break-system-packages -r /tmp/requirements.robot_object.txt

RUN if [[ "${INSTALL_OLLAMA_SERVER}" == "1" ]]; then \
      curl -fsSL https://ollama.com/download/ollama-linux-arm64.tar.zst | tar --zstd -x -C /usr ; \
    fi

RUN cat > /usr/local/bin/arm64_robot_entrypoint.sh <<'SH'
#!/usr/bin/env bash
set -e
mkdir -p "${XDG_RUNTIME_DIR:-/tmp/runtime-work}" "${HF_HOME:-/workspace/.cache/huggingface}" "${OLLAMA_MODELS:-/workspace/.ollama/models}"
if [ -f "/opt/ros/${ROS_DISTRO}/setup.bash" ]; then source "/opt/ros/${ROS_DISTRO}/setup.bash"; fi
if [ -f "/workspace/work_ws/install/setup.bash" ]; then source "/workspace/work_ws/install/setup.bash"; fi
if [ -f "/home/jimmy/work_ws/visual/install/setup.bash" ]; then source "/home/jimmy/work_ws/visual/install/setup.bash"; fi
if [[ "${OLLAMA_IN_CONTAINER:-0}" == "1" ]] && command -v ollama >/dev/null 2>&1; then
    if ! pgrep -x ollama >/dev/null 2>&1; then
        echo "[INFO] starting ollama serve in background: ${OLLAMA_HOST:-0.0.0.0:11434}"
        nohup ollama serve >/tmp/ollama.log 2>&1 &
        sleep 1
    fi
fi
exec "$@"
SH
RUN chmod +x /usr/local/bin/arm64_robot_entrypoint.sh

RUN set -eux; \
    groupadd -f render; groupadd -f video; groupadd -f dialout; groupadd -f plugdev; \
    if ! getent group "${GID}" >/dev/null; then groupadd -g "${GID}" "${USERNAME}"; fi; \
    if ! id -u "${USERNAME}" >/dev/null 2>&1; then useradd -m -u "${UID}" -g "${GID}" -s /bin/bash "${USERNAME}"; fi; \
    usermod -aG sudo,video,render,dialout,plugdev "${USERNAME}"; \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}"; \
    chmod 0440 "/etc/sudoers.d/${USERNAME}"; \
    mkdir -p /workspace /workspace/work_ws /workspace/work_ws/src /workspace/.cache/huggingface /workspace/.ollama/models /home/jimmy/work_ws "${XDG_RUNTIME_DIR}"; \
    chown -R "${USERNAME}:${GID}" /workspace "${XDG_RUNTIME_DIR}" /home/${USERNAME}; \
    chmod 700 "${XDG_RUNTIME_DIR}"

RUN echo "source /opt/ros/${ROS_DISTRO}/setup.bash" >> /home/${USERNAME}/.bashrc \
    && echo "export ROS_DISTRO=${ROS_DISTRO}" >> /home/${USERNAME}/.bashrc \
    && echo "export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp" >> /home/${USERNAME}/.bashrc \
    && echo "export OLLAMA_BASE_URL=http://127.0.0.1:11434" >> /home/${USERNAME}/.bashrc \
    && chown ${USERNAME}:${GID} /home/${USERNAME}/.bashrc

RUN source /opt/ros/${ROS_DISTRO}/setup.bash && ros2 --help > /tmp/ros2_help.txt && ros2 pkg list | grep nav2_msgs

USER ${USERNAME}
WORKDIR /home/jimmy/work_ws/docker
ENTRYPOINT ["/usr/local/bin/arm64_robot_entrypoint.sh"]
CMD ["/bin/bash"]
