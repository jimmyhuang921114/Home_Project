# Host paths
HOME_PROJECT_ROOT=/path/to/Home_Project
DOCKER_ROOT=/path/to/docker
VISION_CONTRACT_ROOT=/path/to/Home_Project_vision_contract

# ROS / DDS
ROS_DOMAIN_ID=40
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///home/user/.ros/cyclonedds.xml
JIMMY_CYCLONEDDS=/path/to/cyclonedds.xml
CYCLONE_INTERFACE=
JIMMY_IP=
THOR_IP=
JIMMY_NIC=
THOR_NIC=

# Docker identities
NAV2_IMAGE=home-project-nav2:humble
NAV2_CONTAINER=home-project-nav2
THOR_IMAGE=
THOR_CONTAINER=thor-vlm
HYDRA_IMAGE=home-project-hydra-jazzy:latest
HYDRA_CONTAINER=
DB_CONTAINER=robot_object_pg
OLLAMA_CONTAINER=robot_object_ollama
POSTGRES_CONTAINER=robot_object_pg

# Container paths
CONTAINER_WORKSPACE=/workspace
COLCON_ROOT=/colcon
MAP_YAML=/workspace/config/map.yaml
MAP_IMAGE_HOST=/path/to/Home_Project/src/Home_Project/home_project_core/maps/map.png
SWAGGER_YAML=/workspace/config/swagger_regen_20260629_190113/nav2_waypoints_swagger.yaml
SWAGGER_GML=/workspace/config/swagger_regen_20260629_190113/graph.gml

# Desktop / GPU
DISPLAY=
QT_X11_NO_MITSHM=1
NVIDIA_VISIBLE_DEVICES=all

# Database and optional services (do not commit real secrets)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=robot_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/robot_db
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Isaac / model assets requiring verification on a new machine
ISAAC_USD_PATH=/path/to/scene.usd
THOR_MODEL_ROOT=/path/to/model/checkpoints
