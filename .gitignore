# =========================
*.pt
*.pth
*.ckpt
*.onnx
*.engine
*.trt
*.safetensors
*.weights
*.bin

# common heavy folders
checkpoints/
pretrained/
datasets/
runs/
outputs/
wandb/

# =========================
# Media / bags / videos
# =========================
*.bag
*.db3
*.mcap
*.mp4
*.avi
*.mov
*.mkv
*.png
*.jpg
*.jpeg

# 如果 map 圖片要跟專案一起保存，不要忽略 map 資料夾。
# 但大型測試影像、影片、rosbag 不要放 git。

# =========================
# IDE
# =========================
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/

