*.py[cod]
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Python env / local config
.venv/
venv/
env/
.env
.env.*
!.env.example

