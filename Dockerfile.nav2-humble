# syntax=docker/dockerfile:1
FROM python:3.10-slim AS retrieval-wheel
COPY --from=retrieval pyproject.toml /src/pyproject.toml
COPY --from=retrieval src /src/src
WORKDIR /src
RUN python3 -m pip wheel --no-cache-dir --no-deps --wheel-dir /wheels .

FROM osrf/ros:humble-desktop-full-jammy

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG USERNAME=jimmy
ARG UID=1000
ARG GID=1000
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-navigation2 \
    ros-humble-nav2-bringup \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-tf2-tools \
    ros-humble-image-transport \
    ros-humble-cv-bridge \
    ros-humble-diagnostic-updater \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-pytest \
    python3-pip \
    python3-yaml \
    python3-networkx \
    python3-numpy \
    python3-opencv \
    build-essential \
    git \
    iproute2 \
    iputils-ping \
    curl \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Versioned Python core is installed into the image from the repository's fixed
# local distribution context.  ROS nodes never depend on source-tree PYTHONPATH.
COPY --from=retrieval-wheel /wheels/robot_object_retrieval-0.1.0-py3-none-any.whl /opt/home_project/
RUN env -u PYTHONPATH python3 -m pip install --no-cache-dir \
      'psycopg[binary]==3.2.9' 'python-dotenv==1.0.1' 'PyYAML>=6,<7' \
      'Pillow>=10,<12' 'textual>=0.89.1,<2.0' 'fastapi>=0.115,<1.0' \
      'uvicorn>=0.30,<1.0' 'pytest>=8,<9' 'httpx>=0.27,<1.0' \
    && env -u PYTHONPATH python3 -m pip install --no-cache-dir --no-deps /opt/home_project/robot_object_retrieval-0.1.0-py3-none-any.whl \
    && python3 -c 'import robot_object_retrieval; print(robot_object_retrieval.__file__)'

RUN groupadd --gid "${GID}" "${USERNAME}" \
    && useradd --uid "${UID}" --gid "${GID}" --create-home --shell /bin/bash "${USERNAME}" \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}" \
    && chmod 0440 "/etc/sudoers.d/${USERNAME}" \
    && mkdir -p /workspace /colcon/build /colcon/install /colcon/log "/home/${USERNAME}/.ros" \
    && chown -R "${UID}:${GID}" /colcon "/home/${USERNAME}"

COPY --chmod=0755 entrypoint_nav2_humble.sh /usr/local/bin/entrypoint_nav2_humble.sh

ENV ROS_DISTRO=humble \
    ROS_DOMAIN_ID=40 \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    CYCLONEDDS_URI=file:///home/jimmy/.ros/cyclonedds.xml \
    QT_X11_NO_MITSHM=1

USER ${USERNAME}
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint_nav2_humble.sh"]
CMD ["bash"]
